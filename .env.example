# Exposed to the React build. This is safe to configure in Vercel.
REACT_APP_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Local-only Cloudinary Management API credentials.
# Never commit real values or configure these for the frontend deployment.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
